<?xml version="1.0" encoding="utf-8"?>
<!--
  Stands in for Glance's click ripple; see the Op.Clickable arm in PreviewCompatGlanceModifier.
  A plain state list rather than a ripple: HyperOS 4's launcher took the ripple overlay as the
  tap target. The overlay is not clickable itself, so it picks up the pressed state from the
  clickable box beneath it. Neutral grey so the highlight reads on both the light and the
  dark pill.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#29808080" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
