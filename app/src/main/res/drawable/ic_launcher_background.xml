<?xml version="1.0" encoding="utf-8"?>
<!--
  Blue -> purple -> terracotta wash, the same family the config screen paints behind the
  widget preview. Endpoints are the CSS `linear-gradient(115deg, ...)` gradient line solved
  for a 108x108 box, so the ramp meets the corners at the angle the design specifies.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="-11.038"
                android:startY="23.676"
                android:endX="119.038"
                android:endY="84.324">
                <item android:color="@color/brand_gradient_start" android:offset="0.0" />
                <item android:color="@color/brand_gradient_mid" android:offset="0.52" />
                <item android:color="@color/brand_gradient_end" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
